# Kopieer dit bestand naar .env en vul de waarden in

# Database (PostgreSQL — bv. Neon)
DATABASE_URL="postgresql://username:password@host/database?sslmode=require"

# NextAuth
NEXTAUTH_SECRET="genereer-een-geheime-sleutel-met-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# ─── AI-taalcoach (allemaal optioneel) ───────────────────────────────────────
# De AI-coach werkt ALTIJD, ook zonder onderstaande sleutels (ingebouwde coach).
#
# Optie 1 (aanbevolen voor Vercel): Google Gemini — GRATIS tier
# Sleutel verkrijgen op https://aistudio.google.com/apikey
# GEMINI_API_KEY="jouw-gemini-sleutel"
# GEMINI_MODEL="gemini-2.0-flash"
#
# Optie 2 (lokaal): Ollama
# OLLAMA_BASE_URL="http://localhost:11434"
# OLLAMA_MODEL="llama3.2"
